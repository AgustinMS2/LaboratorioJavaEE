#Estos comandos también se pude ejecutar desde la consola de administración jboss-cli.sh
#Además tambien se puede seguir un wizart desde la consola de administración web
#No queremos tener que realizar estos pasos a mano cada vez que provisionamos el servidor,
#por eso lo hacemos desde aqui de forma automática
connect
    #1ero se agrega un modulo con el driver MySQL
    try
        module add --name=com.mysql --resources=./mysql-connector-j-9.1.0.jar --dependencies=javax.api,javax.transaction.api
        echo "Se registra el modulo para driver MySQL"
    catch
        echo "El modulo para el driver ya esta registrado"
    end-try
    #2do se registra el driver
    try
        /subsystem=datasources/jdbc-driver=mysql:add(driver-name="mysql",driver-module-name="com.mysql",driver-class-name=com.mysql.cj.jdbc.Driver)
        echo "Se registra driver MySQL"
    catch
        echo "No se registra el driver, ya esta registrado"
    end-try
    #3ero se crea el datasource
    try
        data-source add --name=tallerjavadb --jndi-name=java:jboss/MySQL --driver-name=mysql --connection-url=jdbc:mysql://localhost:3306/tallerJava --user-name=martin --password=1234
        echo "Se crea nuevo datasource para tallerjavadb"
    catch
        echo "No se crea datasource, ya existe"
    end-try
