<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="tallerPU" transaction-type="JTA">

        <!-- H2 embebido de WildFly: se crea al iniciar y se elimina al apagar -->
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>

        <!-- moduloClientes -->
        <class>org.tallerJava.moduloClientes.dominio.Cliente</class>
        <class>org.tallerJava.moduloClientes.dominio.ClienteComun</class>
        <class>org.tallerJava.moduloClientes.dominio.ClienteProfesional</class>
        <class>org.tallerJava.moduloClientes.dominio.MedioPago</class>
        <class>org.tallerJava.moduloClientes.dominio.Tarjeta</class>
        <class>org.tallerJava.moduloClientes.dominio.CuentaUTE</class>
        <class>org.tallerJava.moduloClientes.dominio.Reclamo</class>

        <!-- moduloCargas -->
        <class>org.tallerJava.moduloCargas.dominio.Carga</class>
        <class>org.tallerJava.moduloCargas.dominio.Cargador</class>
        <class>org.tallerJava.moduloCargas.dominio.EstacionCarga</class>

        <!-- moduloPagos -->
        <class>org.tallerJava.moduloPagos.dominio.Pago</class>

        <properties>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>
