    {
      "name": "Clientes",
      "item": [
        {
          "name": "Registrar cliente comun",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "description": "Crea un cliente comun. Guarda automaticamente el id devuelto en la variable de coleccion clienteId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"{{cedula}}\",\n  \"nombreCompleto\": \"Juan Perez\",\n  \"telefono\": \"099123456\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"tipo\": \"COMUN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"clienteId\", jsonData.id);",
                  "}",
                  "pm.test(\"Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
